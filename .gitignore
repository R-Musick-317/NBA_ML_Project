# ==========================================
# 1. PYTHON VIRTUAL ENVIRONMENTS
# ==========================================
nba_env/
venv/
.venv/
env/

# ==========================================
# 2. PYTHON CACHE & BYTECODE
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# ==========================================
# 3. JUPYTER NOTEBOOKS & ML ARTIFACTS
# ==========================================
.ipynb_checkpoints/
# Uncomment the lines below if you save large trained ML models locally:
# *.pkl
# *.joblib
# *.h5

# ==========================================
# 4. CREDENTIALS & API KEYS
# ==========================================
.env
.env.*
*.key
secrets.json

# ==========================================
# 5. VS CODE & OS SYSTEM FILES
# ==========================================
.vscode/
Thumbs.db
Desktop.ini
.DS_Store

# ==========================================
# 6. POWER BI & DATA FILES (OPTIONAL)
# ==========================================
# Ignore Power BI lock/temp files while keeping your main .pbix file tracked
~$*.pbix
*.pbix.tmp

# Uncomment 'data/*.csv' below ONLY if you do NOT want your generated CSVs 
# (Dim_Team.csv, nba_team_per_game_stats.csv, etc.) pushed to GitHub:
# data/*.csv